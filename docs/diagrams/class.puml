@startuml
title Task 2.3 - Class Diagram: Mô hình miền BrewLite
skinparam classAttributeIconSize 0
hide empty methods
class User {
  +id: UUID
  +email: string
  -passwordHash: string
  +loyaltyPoints: int
}
class Product {
  +id: UUID
  +name: string
  +price: Decimal
  +imageUrl: string
  +stock: int
  +version: int (*)
}
class Promotion {
  +id: UUID
  +code: string
  +ruleConfig: JSON (*)
  +isActive: boolean (*)
}
class Order {
  +id: UUID
  +userId: UUID
  +status: OrderStatus
  +total: Decimal
  +createdAt: DateTime
  +promotionId: UUID? (*)
}
class OrderItem {
  +id: UUID
  +orderId: UUID
  +productId: UUID
  +size: Size
  +qty: int
  +lineTotal: Decimal
}
class Payment {
  +id: UUID
  +orderId: UUID
  +idempotencyKey: string
  +amount: Decimal
  +method: PaymentMethod
  +status: PaymentStatus (*)
}
class LoyaltyTransaction {
  +id: UUID (*)
  +userId: UUID (*)
  +orderId: UUID (*)
  +points: int (*)
}
enum OrderStatus {
 PENDING
 PAID
 PAYMENT_FAILED
 PREPARING
 READY
 COMPLETED
 CANCELLED
}
enum PaymentStatus {
 PROCESSING
 SUCCEEDED
 FAILED
 UNKNOWN
}
enum PaymentMethod {
 WALLET
 CARD
}
enum Size {
 S
 M
 L
}
User "1" -- "0..*" Order
User "1" -- "0..*" LoyaltyTransaction
Order "1" *-- "1..*" OrderItem
Product "1" -- "0..*" OrderItem
Promotion "1" -- "0..*" Order
Order "1" -- "0..*" Payment
Order "1" -- "0..1" LoyaltyTransaction
note bottom of LoyaltyTransaction
 (*) Thuộc tính / enum bổ sung để thiết kế domain;
 cần nhóm đối chiếu và duyệt với SRS trước khi triển khai CSDL.
end note
@enduml
