# BrewLite local development. Replace the sample password and JWT secret.
# Do not commit .env files or use these sample values in production.

# Local NestJS connection; Compose publishes its isolated PostgreSQL on 5433.
DB_HOST=localhost
DB_PORT=5433
DB_USER=brewlite
DB_PASSWORD=replace_with_a_local_database_password
DB_NAME=brewlite
DB_PUBLISHED_PORT=5433

# NestJS and Docker Compose published ports
PORT=3001
WEB_ORIGIN=http://localhost:3000,http://localhost:3002
API_PUBLISHED_PORT=3003
WEB_PUBLISHED_PORT=3002
JWT_SECRET=replace_with_a_unique_random_secret_of_at_least_32_bytes
PAYMENT_DEMO_ENABLED=false

# URL for running Next.js directly with npm; Compose uses the Docker URL below.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL_DOCKER=http://127.0.0.1:3003
